# ---------------------------------------------------------------
# HostelHub environment variables (NAMES ONLY — never put real
# values in this file, and never commit a real .env file).
#
# HostelHub uses Firebase: Authentication for sign-in and Firestore for the
# data. The SAME Firebase project is used on a laptop and on Vercel, so the app
# needs these settings in both places. There is no local database.
#
# Locally: copy this file to .env and fill it in.
# On Vercel: Project → Settings → Environment Variables (paste the JSON
# value WITHOUT the surrounding quotes).
# ---------------------------------------------------------------

# Long random text used to sign session cookies (required in production).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
HOSTELHUB_SECRET_KEY=

# Set to 1 only while developing locally to see Flask debug pages.
# (Ignored in production: debug is always off there.)
HOSTELHUB_DEBUG=

# Vercel sets VERCEL=1 automatically. Set HOSTELHUB_ENV=production to try
# production rules (secret key required, secure cookies) on your own computer.
HOSTELHUB_ENV=

# --- Firebase (Authentication + Firestore) ---
# FIREBASE_SERVICE_ACCOUNT: the SECRET service-account key JSON, on one line, wrapped in single quotes
#   (Firebase console -> Project settings -> Service accounts -> Generate new private key).
#   It gives full access to the project: NEVER commit it and never send it to the browser.
FIREBASE_SERVICE_ACCOUNT=

# Locally you may instead point at the downloaded service-account JSON file, kept
# outside Git (the .gitignore already covers *firebase-adminsdk*.json and secrets/).
FIREBASE_CREDENTIALS_FILE=

# Optional: the PUBLIC web config JSON. config.py already has the hostelhub-83310
# values, so it only needs to be set to use another project.
FIREBASE_CLIENT_CONFIG=

# --- Complaint photos (optional; Firebase Storage is NOT used) ---
# local = keep photos in uploads/complaints/ on this computer (default locally)
# none  = photo uploads switched off (default on Vercel, whose disk is temporary;
#         "local" is refused there)
COMPLAINT_IMAGE_STORAGE=

# ---------------------------------------------------------------
# HostelHub environment variables (NAMES ONLY — never put real
# values in this file, and never commit a real .env file).
#
# Local development needs NONE of these: without them HostelHub
# uses SQLite (database/hostelhub.db) and local uploads.
#
# For deployment, add the values in:
#   Vercel → Project → Settings → Environment Variables
# ---------------------------------------------------------------

# Long random text used to sign session cookies (required in production).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
HOSTELHUB_SECRET_KEY=

# Set to 1 only while developing locally to see Flask debug pages.
# (Ignored in production: debug is always off there.)
HOSTELHUB_DEBUG=

# Vercel sets VERCEL=1 automatically. Set HOSTELHUB_ENV=production to try
# production rules (secret key required, secure cookies) on your own computer.
HOSTELHUB_ENV=

# PostgreSQL connection string (Supabase: Project Settings -> Database ->
# Connection string -> "Transaction pooler"). Leave empty locally to use SQLite.
# Example shape (NOT real): postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=

# PRIVATE photo storage (Supabase: Project Settings -> API Keys).
# SUPABASE_SECRET_KEY is a server-only secret: never put it in HTML/JavaScript.
# Create a PRIVATE bucket named complaint-photos (or set SUPABASE_BUCKET).
# Leave SUPABASE_URL empty locally to save photos in uploads/complaints/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=complaint-photos

# OPTIONAL, developers only: an EMPTY PostgreSQL test database. The test suite
# wipes it on every test, so never point it at real data.
HOSTELHUB_TEST_DATABASE_URL=

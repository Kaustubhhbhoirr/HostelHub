# ---------------------------------------------------------------
# HostelHub environment variables (NAMES ONLY — never put real
# values in this file, and never commit a real .env file).
#
# Local development needs NONE of these: without them HostelHub
# uses SQLite (database/hostelhub.db) and local uploads.
#
# For deployment, add the values in:
#   Vercel → Project → Settings → Environment Variables
# ---------------------------------------------------------------

# Long random text used to sign session cookies (required in production).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
HOSTELHUB_SECRET_KEY=

# Set to 1 only while developing locally to see Flask debug pages.
HOSTELHUB_DEBUG=

# ---------------------------------------------------------------
# HostelHub .gitignore
# Never commit: virtual environments, secrets, local files
# ---------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Secrets / environment files (only .env.example is committed)
.env
.env.*
!.env.example

# Uploaded complaint photos are private student data (only the folder is kept).
uploads/**
!uploads/
!uploads/complaints/
!uploads/complaints/.gitkeep

# Downloaded or exported archives (may contain .env or the database)
*.zip

# Vercel CLI local project link
.vercel/

# Personal implementation notebook (kept locally, not published)
bank.md

# Editors, IDEs and tools
.vscode/
.idea/
*.swp
.claude/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Firebase service-account keys (secret: they give full access to the project).
# The file Firebase downloads is named like hostelhub-83310-firebase-adminsdk-xxxxx-1234567890.json.
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
firebase-credentials*.json
secrets/
